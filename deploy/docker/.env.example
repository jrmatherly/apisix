# cp .env.example .env ; .env is gitignored.
APISIX_ADMIN_KEY=change-me-to-a-long-random-string
# Values routes reference as $env://NAME. A reference must be the WHOLE value, so
# Authorization-style vars hold the scheme too ("Bearer sk-..."). Leave unused ones empty.
OPENAI_AUTHORIZATION=
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
# Bearer token for an OpenAI-compatible local server (Ollama/LocalAI). The mock
# in this stack requires exactly "Bearer mock-token" (MOCK_TOKEN in compose.yaml).
LOCAL_LLM_AUTHORIZATION="Bearer mock-token"
# key-auth key for the demo consumer in deploy/routes (openssl rand -hex 16).
# Required: compose refuses to start while it is empty.
DEMO_CONSUMER_KEY=
