# cp .env.example .env ; .env is gitignored.
APISIX_ADMIN_KEY=change-me-to-a-long-random-string
# Provider keys, referenced from routes as $env://NAME. Leave unused ones empty.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
# Bearer token for an OpenAI-compatible local server (Ollama/LocalAI); the mock ignores it.
LOCAL_LLM_API_KEY=unused
