#% if apisix_enabled %#
---
apiVersion: v1
kind: Secret
metadata:
  name: apisix-provider-keys
stringData:
  DEMO_CONSUMER_KEY: "#{ apisix.demo_consumer_key }#"
  OPENAI_AUTHORIZATION: "Bearer #{ apisix.openai_api_key }#"
  ANTHROPIC_API_KEY: "#{ apisix.anthropic_api_key }#"
  AZURE_OPENAI_API_KEY: "#{ apisix.azure_openai_api_key }#"
  #% if nvidia_enabled %#
  LOCAL_LLM_AUTHORIZATION: "Bearer #{ localai.api_key }#"
  #% endif %#
#% endif %#
