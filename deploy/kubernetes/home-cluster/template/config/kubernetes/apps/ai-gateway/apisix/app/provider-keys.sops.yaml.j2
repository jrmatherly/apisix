#% if apisix_enabled %#
---
apiVersion: v1
kind: Secret
metadata:
  name: apisix-provider-keys
stringData:
  OPENAI_API_KEY: "#{ apisix.openai_api_key }#"
  ANTHROPIC_API_KEY: "#{ apisix.anthropic_api_key }#"
  AZURE_OPENAI_API_KEY: "#{ apisix.azure_openai_api_key }#"
  #% if nvidia_enabled %#
  LOCAL_LLM_API_KEY: "#{ localai.api_key }#"
  #% endif %#
#% endif %#
